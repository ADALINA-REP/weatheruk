default_platform(:ios)

platform :ios do
  desc "Build and upload iOS App to App Store Connect / TestFlight"
  lane :release do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_filepath = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      duration: 1200,
      in_house: false
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      scheme: "WeatherUK",
      workspace: "WeatherUK.xcworkspace",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "WeatherUK.ipa",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_IDENTIFIER"] => ENV["PROVISIONING_PROFILE_NAME"] || "WeatherUK AppStore"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
